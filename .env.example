# Satori configuration. Copy this file to .env.local and uncomment what you need.
# Everything is optional: with no .env.local at all, Satori runs fully offline
# (except the Desmos calculator) with every non-AI feature working.
# .env.local is git-ignored. Never put real keys in this file.

# --- Database ---------------------------------------------------------------
# Path of the SQLite file that holds all progress. Default: data/satori.db
# SATORI_DB_PATH=./data/satori.db

# --- Desmos graphing calculator ---------------------------------------------
# Your Desmos API key (https://www.desmos.com/my-api). Without it Satori uses
# Desmos's public demo key, which is fine for personal local use.
# NEXT_PUBLIC_DESMOS_API_KEY=your-desmos-api-key

# --- AI features (optional: tutor, question generator, AI custom lessons) ----
# Option 1: Claude. Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# Alternative to ANTHROPIC_API_KEY if you authenticate with a bearer token.
# ANTHROPIC_AUTH_TOKEN=your-token-here
# Claude model to use. Default: claude-opus-5
# SATORI_AI_MODEL=claude-opus-5

# Option 2: a free local model through Ollama (https://ollama.com). Both are required.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# --- OpenSAT importer (optional) --------------------------------------------
# Override the address of the OpenSAT public API used by Content tools → Import.
# OPENSAT_URL=https://pinesat.duckdns.org/api/questions
